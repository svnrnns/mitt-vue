{
  "name": "mitt-vue",
  "private": false,
  "version": "2.1.4",
  "description": "Lightweight utility for integrating mitt with Vue 2 and Vue 3",
  "license": "MIT",
  "type": "module",
  "main": "dist/mitt-vue.cjs",
  "module": "dist/mitt-vue.js",
  "exports": {
    ".": {
      "import": "./dist/mitt-vue.js",
      "require": "./dist/mitt-vue.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svnrnns/mitt-vue.git"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "event-emitter",
    "mitt",
    "event-management",
    "vue-events",
    "event-subscription",
    "event-handling",
    "vue-components",
    "mitt-integration",
    "event-listener",
    "vue-utility",
    "vue-event-emitter",
    "event-emitters-in-vue",
    "vue-hook-for-events",
    "event-management-library",
    "vue-event-handling",
    "vue-event-system",
    "event-bus-vue",
    "vue-event-listener",
    "vue2-event-handling",
    "vue3-event-handling"
  ],
  "bugs": {
    "url": "https://github.com/svnrnns/mitt-vue/issues"
  },
  "homepage": "https://github.com/svnrnns/mitt-vue",
  "author": "seven rings (https://twitter.com/svnrnns)",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "mitt": "^3",
    "vue": "^2.6.0 || ^3.0.0"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.11",
    "typescript": "^5.8",
    "vite": "^7",
    "vite-plugin-dts": "^2.3",
    "vitest": "^4.0.15"
  }
}
